{
  "key": "video-game-production.v2",
  "version": 2,
  "displayName": "Video Game Production",
  "lifecyclePolicyKey": "video-game.lifecycle.v2",
  "defaultBoardProfileKey": "video-game-production-board.v2",
  "authorityPolicyKey": "video-game.authority.v1",
  "metadataSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["workingTitle", "genre", "targetPlatforms", "playerAudience", "enginePreference", "contentRatingTarget", "creativePillars", "businessModel", "liveOperationsExpected", "onlineMultiplayerExpected", "accessibilityTargets", "localizationTargets"],
    "properties": {
      "workingTitle": { "type": "string" },
      "genre": { "type": "string" },
      "targetPlatforms": { "type": "array", "items": { "type": "string" } },
      "playerAudience": { "type": "string" },
      "enginePreference": { "type": "string" },
      "contentRatingTarget": { "type": "string" },
      "creativePillars": { "type": "array", "items": { "type": "string" } },
      "businessModel": { "type": "string" },
      "liveOperationsExpected": { "type": "boolean" },
      "onlineMultiplayerExpected": { "type": "boolean" },
      "accessibilityTargets": { "type": "array", "items": { "type": "string" } },
      "localizationTargets": { "type": "array", "items": { "type": "string" } }
    }
  },
  "boardWorkflow": {
    "columns": [
      { "key": "backlog", "name": "Backlog", "category": "ToDo", "wipPolicy": "Disabled" },
      { "key": "ready", "name": "Ready", "category": "ToDo", "wipPolicy": "Disabled" },
      { "key": "in-progress", "name": "In Progress", "category": "InProgress", "wipPolicy": "HardLimit", "wipLimit": 12 },
      { "key": "producer-review", "name": "Producer Review", "category": "InProgress", "wipPolicy": "HardLimit", "wipLimit": 8 },
      { "key": "done", "name": "Done", "category": "Done", "wipPolicy": "Disabled" }
    ]
  },
  "orchestration": {
    "name": "Video Game Sprint Delivery",
    "initialStageKey": "ready",
    "mergeMode": "ManagerApproval",
    "concurrency": { "global": 128, "organization": 48, "board": 16, "defaultStage": 12, "defaultAssignee": 2 },
    "stages": [
      {
        "key": "ready", "name": "Ready", "stageType": "Queue", "columnKey": "ready",
        "instructions": "Wait for the Producer to bind an exact specialist installation and approved planning package.",
        "inputSchemaJson": "{\"type\":\"object\"}", "outputSchemaJson": "{\"type\":\"object\"}",
        "timeoutSeconds": 300, "retryPolicy": { "maximumAttempts": 1, "initialDelaySeconds": 10, "maximumDelaySeconds": 10 }
      },
      {
        "key": "specialist-execution", "name": "Specialist Execution", "stageType": "AgentExecution", "columnKey": "in-progress",
        "instructions": "Execute only the assigned role-owned work from the canonical planning snapshot and exact approved artifact package. Return a standard completed, blocked, or failed outcome with evidence.",
        "inputSchemaJson": "{\"type\":\"object\"}", "outputSchemaJson": "{\"type\":\"object\"}",
        "timeoutSeconds": 1800, "concurrencyLimit": 12,
        "retryPolicy": { "maximumAttempts": 3, "initialDelaySeconds": 30, "maximumDelaySeconds": 300 }
      },
      {
        "key": "producer-review", "name": "Producer Review", "stageType": "ManagerApproval", "columnKey": "producer-review",
        "instructions": "Verify the exact output evidence and acceptance criteria without overriding creative or QA authority.",
        "inputSchemaJson": "{\"type\":\"object\"}", "outputSchemaJson": "{\"type\":\"object\"}",
        "timeoutSeconds": 86400, "retryPolicy": { "maximumAttempts": 1, "initialDelaySeconds": 60, "maximumDelaySeconds": 60 }
      },
      {
        "key": "done", "name": "Done", "stageType": "Terminal", "columnKey": "done", "instructions": "Delivery evidence accepted.",
        "inputSchemaJson": "{\"type\":\"object\"}", "outputSchemaJson": "{\"type\":\"object\"}",
        "timeoutSeconds": 60, "retryPolicy": { "maximumAttempts": 1, "initialDelaySeconds": 10, "maximumDelaySeconds": 10 },
        "isSuccessfulTerminal": true
      },
      {
        "key": "cancelled", "name": "Cancelled", "stageType": "Terminal", "columnKey": "done", "instructions": "Delivery was rejected or cancelled.",
        "inputSchemaJson": "{\"type\":\"object\"}", "outputSchemaJson": "{\"type\":\"object\"}",
        "timeoutSeconds": 60, "retryPolicy": { "maximumAttempts": 1, "initialDelaySeconds": 10, "maximumDelaySeconds": 10 }
      }
    ],
    "transitions": [
      { "fromStageKey": "ready", "outcomeCode": "ready", "toStageKey": "specialist-execution" },
      { "fromStageKey": "specialist-execution", "outcomeCode": "completed", "toStageKey": "producer-review" },
      { "fromStageKey": "producer-review", "outcomeCode": "approved", "toStageKey": "done" },
      { "fromStageKey": "producer-review", "outcomeCode": "rejected", "toStageKey": "specialist-execution", "maximumTraversals": 3 }
    ]
  },
  "assignmentPolicy": {
    "exactRoleRequired": true,
    "skillMatchMode": "RequiredThenPreferred",
    "roles": [
      { "roleKey": "game-producer", "eligibleWorkItemTypeKeys": [], "defaultRelevantSpecializationKeys": ["game-production", "sprint-planning", "delivery-forecasting", "dependency-risk-capacity-management", "management-reporting"], "requiredCapabilityKeys": [] },
      { "roleKey": "game-designer", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.research-spike.v1", "video-game.creative-review.v1"], "defaultRelevantSpecializationKeys": ["game-design", "gameplay-systems", "progression-balance", "game-content", "prototype-design"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-technical-director", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.research-spike.v1", "video-game.creative-review.v1"], "defaultRelevantSpecializationKeys": ["technical-feasibility", "runtime-architecture", "engine-integration", "performance-budgets", "technical-decomposition"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-engineer", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.bug.v1", "video-game.research-spike.v1"], "defaultRelevantSpecializationKeys": ["gameplay-programming", "gameplay-systems", "engine-integration", "automated-testing", "build-diagnostics"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-quality-assurance", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.bug.v1", "video-game.research-spike.v1"], "defaultRelevantSpecializationKeys": ["test-planning", "build-validation", "defect-reproduction", "regression-testing", "compatibility-testing", "accessibility-testing"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "playtest-researcher", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.research-spike.v1"], "defaultRelevantSpecializationKeys": ["playtest-planning", "research-design", "consent-governance", "research-analysis"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-art-director", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.creative-review.v1"], "defaultRelevantSpecializationKeys": ["art-direction"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-artist", "eligibleWorkItemTypeKeys": ["video-game.task.v1"], "defaultRelevantSpecializationKeys": ["asset-production"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "technical-artist", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.bug.v1"], "defaultRelevantSpecializationKeys": ["asset-pipelines", "engine-integration", "visual-performance"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "narrative-designer", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.creative-review.v1"], "defaultRelevantSpecializationKeys": ["narrative-design"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "audio-designer", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.creative-review.v1"], "defaultRelevantSpecializationKeys": ["audio-design"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "level-designer", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.creative-review.v1"], "defaultRelevantSpecializationKeys": ["level-design"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-ui-ux-accessibility-designer", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.creative-review.v1"], "defaultRelevantSpecializationKeys": ["ui-ux-accessibility-design"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-build-release-engineer", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.bug.v1"], "defaultRelevantSpecializationKeys": ["build-release-engineering"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-networking-engineer", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.bug.v1"], "defaultRelevantSpecializationKeys": ["game-networking", "game-security-privacy"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-economy-designer", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.research-spike.v1"], "defaultRelevantSpecializationKeys": ["game-economy", "progression-balance"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-localization-specialist", "eligibleWorkItemTypeKeys": ["video-game.task.v1"], "defaultRelevantSpecializationKeys": ["game-localization"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-security-privacy", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.bug.v1", "video-game.research-spike.v1"], "defaultRelevantSpecializationKeys": ["game-security-privacy"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-marketing-community", "eligibleWorkItemTypeKeys": ["video-game.task.v1"], "defaultRelevantSpecializationKeys": ["game-marketing-community"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-platform-certification", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.bug.v1"], "defaultRelevantSpecializationKeys": ["platform-certification"], "requiredCapabilityKeys": ["work.execution.run"] },
      { "roleKey": "game-live-operations", "eligibleWorkItemTypeKeys": ["video-game.task.v1", "video-game.bug.v1"], "defaultRelevantSpecializationKeys": ["live-operations"], "requiredCapabilityKeys": ["work.execution.run"] }
    ],
    "planningQuorums": [
      { "key": "detailed-backlog", "lifecycleStageKeys": ["concept", "pre-production", "prototype", "vertical-slice", "production", "alpha", "beta", "release-candidate", "launch", "post-launch-stabilization", "live-operations"], "requiredRoleKeys": ["game-designer", "game-technical-director"] },
      { "key": "sprint-readiness", "lifecycleStageKeys": ["prototype", "vertical-slice", "production", "alpha", "beta", "release-candidate", "launch", "post-launch-stabilization", "live-operations"], "requiredRoleKeys": ["game-quality-assurance"], "includeAssignedRoles": true }
    ]
  },
  "lifecycle": {
    "stages": [
      { "key": "intake", "label": "Intake" },
      { "key": "concept", "label": "Concept" },
      { "key": "pre-production", "label": "Pre-production" },
      { "key": "prototype", "label": "Prototype" },
      { "key": "vertical-slice", "label": "Vertical Slice" },
      { "key": "production", "label": "Production" },
      { "key": "alpha", "label": "Alpha" },
      { "key": "beta", "label": "Beta" },
      { "key": "release-candidate", "label": "Release Candidate" },
      { "key": "launch", "label": "Launch" },
      { "key": "post-launch-stabilization", "label": "Post-launch Stabilization" },
      { "key": "live-operations", "label": "Live Operations" },
      { "key": "closure", "label": "Closure / Sunset" }
    ],
    "transitions": [
      { "from": "intake", "to": "concept" },
      { "from": "concept", "to": "pre-production" },
      { "from": "pre-production", "to": "prototype" },
      { "from": "prototype", "to": "vertical-slice" },
      { "from": "vertical-slice", "to": "production" },
      { "from": "production", "to": "alpha" },
      { "from": "alpha", "to": "beta" },
      { "from": "beta", "to": "release-candidate" },
      { "from": "release-candidate", "to": "launch" },
      { "from": "launch", "to": "post-launch-stabilization" },
      { "from": "post-launch-stabilization", "to": "live-operations" },
      { "from": "post-launch-stabilization", "to": "closure" },
      { "from": "live-operations", "to": "closure" }
    ]
  },
  "milestones": [
    { "key": "vision-approved", "stage": "concept", "requiredEvidenceTypeKeys": ["video-game.vision.v1"], "requiredReviewerRoleKeys": ["creative-director", "game-producer"] },
    { "key": "pre-production-ready", "stage": "pre-production", "requiredEvidenceTypeKeys": ["video-game.gdd.v1", "video-game.technical-design.v1", "video-game.production-plan.v1"], "requiredReviewerRoleKeys": ["game-producer", "game-technical-director", "creative-director"] },
    { "key": "prototype-validated", "stage": "prototype", "requiredEvidenceTypeKeys": ["video-game.runnable-build.v1", "video-game.playtest.v1"], "requiredReviewerRoleKeys": ["game-technical-director", "game-quality-assurance", "creative-director"] },
    { "key": "vertical-slice-approved", "stage": "vertical-slice", "requiredEvidenceTypeKeys": ["video-game.runnable-build.v1", "video-game.playtest.v1"], "requiredReviewerRoleKeys": ["creative-director", "game-producer", "game-technical-director", "game-quality-assurance"] },
    { "key": "production-ready", "stage": "production", "requiredEvidenceTypeKeys": ["video-game.runnable-build.v1", "video-game.production-plan.v1"], "requiredReviewerRoleKeys": ["game-producer", "game-technical-director", "game-quality-assurance"] },
    { "key": "alpha-exit", "stage": "alpha", "requiredEvidenceTypeKeys": ["video-game.runnable-build.v1", "video-game.qa-evaluation-plan.v1", "video-game.performance-evaluation.v1"], "requiredReviewerRoleKeys": ["game-quality-assurance", "game-technical-director", "game-producer"] },
    { "key": "beta-exit", "stage": "beta", "requiredEvidenceTypeKeys": ["video-game.runnable-build.v1", "video-game.playtest.v1", "video-game.accessibility-evaluation.v1"], "requiredReviewerRoleKeys": ["game-quality-assurance", "playtest-researcher", "game-ui-ux-accessibility-designer", "creative-director"] },
    { "key": "release-candidate-approved", "stage": "release-candidate", "requiredEvidenceTypeKeys": ["video-game.runnable-build.v1", "video-game.platform-certification.v1", "video-game.release-plan.v1"], "requiredReviewerRoleKeys": ["game-build-release-engineer", "game-quality-assurance", "creative-director", "game-producer"] },
    { "key": "launch-approved", "stage": "launch", "requiredEvidenceTypeKeys": ["video-game.release-readiness.v1"], "requiredReviewerRoleKeys": ["human-owner"] },
    { "key": "stabilization-exit", "stage": "post-launch-stabilization", "requiredEvidenceTypeKeys": ["video-game.runnable-build.v1", "video-game.qa-evaluation-plan.v1"], "requiredReviewerRoleKeys": ["game-producer", "game-quality-assurance", "game-build-release-engineer"] }
  ],
  "workItemTypes": [
    { "key": "video-game.milestone.v1", "displayName": "Game milestone", "kind": "Epic", "executionMode": "Container", "permittedParentTypeKeys": [], "requiredApprovalPolicyKeys": [] },
    { "key": "video-game.feature.v1", "displayName": "Game feature", "kind": "Story", "executionMode": "Container", "permittedParentTypeKeys": ["video-game.milestone.v1"], "requiredApprovalPolicyKeys": [] },
    { "key": "video-game.content.v1", "displayName": "Game content", "kind": "Story", "executionMode": "Container", "permittedParentTypeKeys": ["video-game.milestone.v1"], "requiredApprovalPolicyKeys": [] },
    { "key": "video-game.task.v1", "displayName": "Game task", "kind": "Task", "executionMode": "Executable", "permittedParentTypeKeys": ["video-game.milestone.v1", "video-game.feature.v1", "video-game.content.v1", "video-game.task.v1"], "requiredApprovalPolicyKeys": [] },
    { "key": "video-game.bug.v1", "displayName": "Game bug", "kind": "Bug", "executionMode": "Executable", "permittedParentTypeKeys": ["video-game.milestone.v1", "video-game.feature.v1", "video-game.content.v1", "video-game.task.v1"], "requiredApprovalPolicyKeys": [] },
    { "key": "video-game.research-spike.v1", "displayName": "Game research / spike", "kind": "Task", "executionMode": "Executable", "permittedParentTypeKeys": ["video-game.milestone.v1", "video-game.feature.v1", "video-game.content.v1"], "requiredApprovalPolicyKeys": [] },
    { "key": "video-game.creative-review.v1", "displayName": "Game creative review", "kind": "Task", "executionMode": "Executable", "permittedParentTypeKeys": ["video-game.milestone.v1", "video-game.feature.v1", "video-game.content.v1"], "requiredApprovalPolicyKeys": [] }
  ],
  "workflow": {
    "states": ["ready", "in-progress", "discipline-review", "integrated-build", "qa-evaluation", "creative-review", "done"]
  },
  "staffing": {
    "requiredRoleKeys": ["game-producer", "game-designer", "game-technical-director", "game-engineer", "game-quality-assurance", "playtest-researcher", "game-art-director", "game-artist", "technical-artist", "narrative-designer", "audio-designer", "level-designer", "game-ui-ux-accessibility-designer", "game-build-release-engineer"],
    "conditionalRoleKeys": ["game-networking-engineer", "game-economy-designer", "game-localization-specialist", "game-security-privacy", "game-marketing-community", "game-platform-certification", "game-live-operations"],
    "conditionalRoles": [
      { "roleKey": "game-networking-engineer", "predicate": { "jsonPath": "$.onlineMultiplayerExpected", "operator": "equals", "value": true }, "blockingDecisionTypeKey": "video-game.missing-conditional-specialist.v1" },
      { "roleKey": "game-economy-designer", "predicate": { "jsonPath": "$.businessModel", "operator": "equals", "value": "free-to-play" }, "blockingDecisionTypeKey": "video-game.missing-conditional-specialist.v1" },
      { "roleKey": "game-localization-specialist", "predicate": { "jsonPath": "$.localizationTargets", "operator": "array-not-empty", "value": true }, "blockingDecisionTypeKey": "video-game.missing-conditional-specialist.v1" },
      { "roleKey": "game-security-privacy", "predicate": { "jsonPath": "$.onlineMultiplayerExpected", "operator": "equals", "value": true }, "blockingDecisionTypeKey": "video-game.missing-conditional-specialist.v1" },
      { "roleKey": "game-marketing-community", "predicate": { "jsonPath": "$.liveOperationsExpected", "operator": "equals", "value": true }, "blockingDecisionTypeKey": "video-game.missing-conditional-specialist.v1" },
      { "roleKey": "game-live-operations", "predicate": { "jsonPath": "$.liveOperationsExpected", "operator": "equals", "value": true }, "blockingDecisionTypeKey": "video-game.missing-conditional-specialist.v1" },
      { "roleKey": "game-platform-certification", "predicate": { "jsonPath": "$.targetPlatforms", "operator": "contains-any", "value": ["console", "mobile"] }, "blockingDecisionTypeKey": "video-game.missing-conditional-specialist.v1" }
    ]
  }
}
